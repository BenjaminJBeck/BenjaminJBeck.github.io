<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shape Recognition AI Trainer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 300;
        }
        
        .content {
            display: flex;
            min-height: 600px;
        }
        
        .section {
            flex: 1;
            padding: 30px;
            border-right: 2px solid #eee;
        }
        
        .section:last-child {
            border-right: none;
        }
        
        .section h2 {
            color: #333;
            margin-bottom: 20px;
            font-weight: 300;
            font-size: 1.5rem;
        }
        
        canvas {
            border: 3px solid #ddd;
            border-radius: 15px;
            cursor: crosshair;
            display: block;
            margin: 20px 0;
            background: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin: 20px 0;
        }
        
        .shape-selector {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .shape-btn {
            padding: 12px 20px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            flex: 1;
            min-width: 80px;
        }
        
        .shape-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .shape-btn.square {
            background: #ff6b6b;
            color: white;
        }
        
        .shape-btn.circle {
            background: #4ecdc4;
            color: white;
        }
        
        .shape-btn.triangle {
            background: #45b7d1;
            color: white;
        }
        
        .shape-btn.selected {
            transform: scale(1.05);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }
        
        .action-btn {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            background: #6c5ce7;
            color: white;
        }
        
        .action-btn:hover {
            background: #5f3dc4;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .action-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }
        
        .status {
            margin: 15px 0;
            padding: 15px;
            border-radius: 10px;
            font-weight: 600;
            text-align: center;
        }
        
        .status.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        
        .status.info {
            background: #cce7ff;
            color: #004085;
            border: 1px solid #b3d7ff;
        }
        
        .status.warning {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }
        
        .training-count {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            border-left: 4px solid #6c5ce7;
        }
        
        .prediction-result {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .file-controls {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            flex-wrap: wrap;
        }
        
        .file-input {
            display: none;
        }
        
        .file-btn {
            padding: 10px 20px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .file-btn:hover {
            background: #218838;
            transform: translateY(-1px);
        }
        
        .export-btn {
            background: #17a2b8;
        }
        
        .export-btn:hover {
            background: #138496;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🤖 Shape Recognition AI</h1>
            <p>Train your AI to recognize squares, circles, and triangles!</p>
        </div>
        
        <div class="content">
            <!-- Training Section -->
            <div class="section">
                <h2>🎯 Training Mode</h2>
                <canvas id="trainCanvas" width="300" height="300"></canvas>
                
                <div class="controls">
                    <div class="shape-selector">
                        <button class="shape-btn square" data-shape="square">⬛ Square</button>
                        <button class="shape-btn circle" data-shape="circle">⭕ Circle</button>
                        <button class="shape-btn triangle" data-shape="triangle">🔺 Triangle</button>
                    </div>
                    
                    <button id="clearTrain" class="action-btn">🗑️ Clear Canvas</button>
                    <button id="addTraining" class="action-btn">➕ Add Training Data</button>
                    <button id="trainModel" class="action-btn">🚀 Train AI Model</button>
                </div>
                
                <div class="training-count">
                    <strong>Training Data:</strong>
                    <div id="trainingStats">
                        Square: <span id="squareCount">0</span> |
                        Circle: <span id="circleCount">0</span> |
                        Triangle: <span id="triangleCount">0</span>
                    </div>
                </div>
                
                <div class="file-controls">
                    <button id="exportData" class="file-btn export-btn">📥 Export Data</button>
                    <input type="file" id="importFile" class="file-input" accept=".json">
                    <label for="importFile" class="file-btn">📤 Import Data</label>
                </div>
                
                <div id="trainStatus" class="status" style="display: none;"></div>
            </div>
            
            <!-- Testing Section -->
            <div class="section">
                <h2>🔮 Test AI</h2>
                <canvas id="testCanvas" width="300" height="300"></canvas>
                
                <div class="controls">
                    <button id="clearTest" class="action-btn">🗑️ Clear Canvas</button>
                    <button id="predict" class="action-btn">🎯 Predict Shape</button>
                </div>
                
                <div id="predictionResult" class="prediction-result" style="display: none;">
                    Prediction: <span id="predictedShape"></span>
                    <br>Confidence: <span id="confidence"></span>%
                </div>
                
                <div id="feedbackSection" class="controls" style="display: none;">
                    <div class="feedback-question">
                        <p style="text-align: center; margin-bottom: 15px; font-weight: 600; color: #333;">
                            Was this prediction correct?
                        </p>
                        <div style="display: flex; gap: 15px; justify-content: center;">
                            <button id="correctBtn" class="action-btn" style="background: #28a745;">
                                ✅ Correct
                            </button>
                            <button id="incorrectBtn" class="action-btn" style="background: #dc3545;">
                                ❌ Incorrect
                            </button>
                        </div>
                    </div>
                </div>
                
                <div id="testStatus" class="status" style="display: none;"></div>
            </div>
        </div>
    </div>

    <script>
        class ShapeAI {
            constructor() {
                this.trainingData = [];
                this.model = null;
                this.selectedShape = 'square';
                this.isDrawing = false;
                this.currentTestImageData = null;
                this.currentPrediction = null;
                
                this.initCanvases();
                this.initEventListeners();
                this.updateTrainingStats();
            }
            
            initCanvases() {
                this.trainCanvas = document.getElementById('trainCanvas');
                this.trainCtx = this.trainCanvas.getContext('2d');
                this.testCanvas = document.getElementById('testCanvas');
                this.testCtx = this.testCanvas.getContext('2d');
                
                // Set up drawing for both canvases
                [this.trainCanvas, this.testCanvas].forEach(canvas => {
                    const ctx = canvas.getContext('2d');
                    ctx.lineWidth = 4;
                    ctx.lineCap = 'round';
                    ctx.strokeStyle = '#333';
                    
                    let isDrawing = false;
                    
                    canvas.addEventListener('mousedown', (e) => {
                        isDrawing = true;
                        const rect = canvas.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        ctx.beginPath();
                        ctx.moveTo(x, y);
                    });
                    
                    canvas.addEventListener('mousemove', (e) => {
                        if (!isDrawing) return;
                        const rect = canvas.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        ctx.lineTo(x, y);
                        ctx.stroke();
                    });
                    
                    canvas.addEventListener('mouseup', () => {
                        isDrawing = false;
                        ctx.closePath();
                    });
                    
                    // Touch events for mobile
                    canvas.addEventListener('touchstart', (e) => {
                        e.preventDefault();
                        const touch = e.touches[0];
                        const mouseEvent = new MouseEvent('mousedown', {
                            clientX: touch.clientX,
                            clientY: touch.clientY
                        });
                        canvas.dispatchEvent(mouseEvent);
                    });
                    
                    canvas.addEventListener('touchmove', (e) => {
                        e.preventDefault();
                        const touch = e.touches[0];
                        const mouseEvent = new MouseEvent('mousemove', {
                            clientX: touch.clientX,
                            clientY: touch.clientY
                        });
                        canvas.dispatchEvent(mouseEvent);
                    });
                    
                    canvas.addEventListener('touchend', (e) => {
                        e.preventDefault();
                        const mouseEvent = new MouseEvent('mouseup', {});
                        canvas.dispatchEvent(mouseEvent);
                    });
                });
            }
            
            initEventListeners() {
                // Shape selection
                document.querySelectorAll('.shape-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('selected'));
                        btn.classList.add('selected');
                        this.selectedShape = btn.dataset.shape;
                    });
                });
                
                // Set initial selection
                document.querySelector('.shape-btn').classList.add('selected');
                
                // Control buttons
                document.getElementById('clearTrain').addEventListener('click', () => this.clearCanvas('train'));
                document.getElementById('clearTest').addEventListener('click', () => this.clearCanvas('test'));
                document.getElementById('addTraining').addEventListener('click', () => this.addTrainingData());
                document.getElementById('trainModel').addEventListener('click', () => this.trainModel());
                document.getElementById('predict').addEventListener('click', () => this.predict());
                document.getElementById('exportData').addEventListener('click', () => this.exportData());
                document.getElementById('importFile').addEventListener('change', (e) => this.importData(e));
                
                // Feedback buttons
                document.getElementById('correctBtn').addEventListener('click', () => this.handleFeedback(true));
                document.getElementById('incorrectBtn').addEventListener('click', () => this.handleFeedback(false));
            }
            
            clearCanvas(type) {
                const canvas = type === 'train' ? this.trainCanvas : this.testCanvas;
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                if (type === 'test') {
                    document.getElementById('predictionResult').style.display = 'none';
                    document.getElementById('feedbackSection').style.display = 'none';
                    document.getElementById('testStatus').style.display = 'none';
                    this.currentTestImageData = null;
                    this.currentPrediction = null;
                }
            }
            
            canvasToImageData(canvas) {
                const ctx = canvas.getContext('2d');
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const data = imageData.data;
                
                // Convert to grayscale and normalize
                const grayscale = [];
                for (let i = 0; i < data.length; i += 4) {
                    const gray = (data[i] + data[i + 1] + data[i + 2]) / 3;
                    grayscale.push(gray / 255);
                }
                
                // Resize to 28x28 for consistency
                return this.resizeImage(grayscale, canvas.width, canvas.height, 28, 28);
            }
            
            resizeImage(data, oldWidth, oldHeight, newWidth, newHeight) {
                const resized = new Array(newWidth * newHeight).fill(0);
                
                for (let y = 0; y < newHeight; y++) {
                    for (let x = 0; x < newWidth; x++) {
                        const srcX = Math.floor((x / newWidth) * oldWidth);
                        const srcY = Math.floor((y / newHeight) * oldHeight);
                        const srcIndex = srcY * oldWidth + srcX;
                        const destIndex = y * newWidth + x;
                        
                        if (srcIndex < data.length) {
                            resized[destIndex] = data[srcIndex];
                        }
                    }
                }
                
                return resized;
            }
            
            addTrainingData() {
                const imageData = this.canvasToImageData(this.trainCanvas);
                
                // Check if canvas is empty
                if (imageData.every(pixel => pixel === 0)) {
                    this.showStatus('trainStatus', 'Please draw a shape first!', 'warning');
                    return;
                }
                
                const sample = {
                    input: imageData,
                    output: this.selectedShape
                };
                
                this.trainingData.push(sample);
                this.updateTrainingStats();
                this.clearCanvas('train');
                this.showStatus('trainStatus', `Added ${this.selectedShape} to training data!`, 'success');
            }
            
            updateTrainingStats() {
                const counts = { square: 0, circle: 0, triangle: 0 };
                this.trainingData.forEach(sample => {
                    counts[sample.output]++;
                });
                
                document.getElementById('squareCount').textContent = counts.square;
                document.getElementById('circleCount').textContent = counts.circle;
                document.getElementById('triangleCount').textContent = counts.triangle;
            }
            
            trainModel() {
                if (this.trainingData.length < 3) {
                    this.showStatus('trainStatus', 'Need at least 3 training samples!', 'warning');
                    return;
                }
                
                this.showStatus('trainStatus', 'Training model...', 'info');
                
                // Simple k-nearest neighbors implementation
                this.model = {
                    data: [...this.trainingData],
                    predict: (input) => {
                        const distances = this.model.data.map(sample => {
                            const distance = this.calculateDistance(input, sample.input);
                            return { distance, output: sample.output };
                        });
                        
                        // Sort by distance and get k=3 nearest neighbors
                        distances.sort((a, b) => a.distance - b.distance);
                        const kNearest = distances.slice(0, Math.min(3, distances.length));
                        
                        // Count votes
                        const votes = {};
                        kNearest.forEach(neighbor => {
                            votes[neighbor.output] = (votes[neighbor.output] || 0) + 1;
                        });
                        
                        // Find most voted class
                        let maxVotes = 0;
                        let prediction = 'square';
                        for (const [shape, count] of Object.entries(votes)) {
                            if (count > maxVotes) {
                                maxVotes = count;
                                prediction = shape;
                            }
                        }
                        
                        const confidence = Math.round((maxVotes / kNearest.length) * 100);
                        return { prediction, confidence };
                    }
                };
                
                this.showStatus('trainStatus', 'Model trained successfully! 🎉', 'success');
            }
            
            calculateDistance(a, b) {
                let sum = 0;
                for (let i = 0; i < a.length; i++) {
                    sum += Math.pow(a[i] - b[i], 2);
                }
                return Math.sqrt(sum);
            }
            
            predict() {
                if (!this.model) {
                    this.showStatus('testStatus', 'Please train the model first!', 'warning');
                    return;
                }
                
                const imageData = this.canvasToImageData(this.testCanvas);
                
                if (imageData.every(pixel => pixel === 0)) {
                    this.showStatus('testStatus', 'Please draw a shape first!', 'warning');
                    return;
                }
                
                const result = this.model.predict(imageData);
                
                // Store current test data for potential feedback
                this.currentTestImageData = imageData;
                this.currentPrediction = result.prediction;
                
                document.getElementById('predictedShape').textContent = result.prediction;
                document.getElementById('confidence').textContent = result.confidence;
                document.getElementById('predictionResult').style.display = 'block';
                document.getElementById('feedbackSection').style.display = 'block';
                document.getElementById('testStatus').style.display = 'none';
            }
            
            exportData() {
                if (this.trainingData.length === 0) {
                    this.showStatus('trainStatus', 'No training data to export!', 'warning');
                    return;
                }
                
                const dataStr = JSON.stringify(this.trainingData, null, 2);
                const dataBlob = new Blob([dataStr], { type: 'application/json' });
                const url = URL.createObjectURL(dataBlob);
                
                const link = document.createElement('a');
                link.href = url;
                link.download = 'shape_training_data.json';
                link.click();
                
                URL.revokeObjectURL(url);
                this.showStatus('trainStatus', 'Training data exported!', 'success');
            }
            
            importData(event) {
                const file = event.target.files[0];
                if (!file) return;
                
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const importedData = JSON.parse(e.target.result);
                        if (Array.isArray(importedData)) {
                            this.trainingData = importedData;
                            this.updateTrainingStats();
                            this.showStatus('trainStatus', `Imported ${importedData.length} training samples!`, 'success');
                        } else {
                            throw new Error('Invalid format');
                        }
                    } catch (error) {
                        this.showStatus('trainStatus', 'Error importing data. Please check file format.', 'warning');
                    }
                };
                reader.readAsText(file);
                
                // Reset file input
                event.target.value = '';
            }
            
            handleFeedback(isCorrect) {
                if (!this.currentTestImageData || !this.currentPrediction) {
                    return;
                }
                
                if (isCorrect) {
                    // Add the correctly predicted sample to training data
                    const sample = {
                        input: this.currentTestImageData,
                        output: this.currentPrediction
                    };
                    
                    this.trainingData.push(sample);
                    this.updateTrainingStats();
                    this.showStatus('testStatus', `Great! Added this ${this.currentPrediction} to training data.`, 'success');
                    
                    // Retrain the model automatically with new data
                    if (this.model) {
                        this.model.data.push(sample);
                    }
                } else {
                    this.showStatus('testStatus', 'Thanks for the feedback! You can manually add the correct shape in training mode.', 'info');
                }
                
                // Hide feedback section and clear canvas
                document.getElementById('feedbackSection').style.display = 'none';
                this.clearCanvas('test');
            }
            
            showStatus(elementId, message, type) {
                const statusEl = document.getElementById(elementId);
                statusEl.textContent = message;
                statusEl.className = `status ${type}`;
                statusEl.style.display = 'block';
                
                if (type === 'success') {
                    setTimeout(() => {
                        statusEl.style.display = 'none';
                    }, 3000);
                }
            }
        }
        
        // Initialize the app
        const app = new ShapeAI();
    </script>
</body>
</html>